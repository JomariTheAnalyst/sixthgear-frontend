# Medusa Backend Configuration
# The URL of your Medusa backend server
# Note: This is a server-side variable (not NEXT_PUBLIC_)
MEDUSA_BACKEND_URL=http://localhost:9000

# Required: Publishable API Key from Medusa Admin
# Create one in Medusa Admin > Settings > Publishable API Keys
# Docs: https://docs.medusajs.com/v2/resources/storefront-development/publishable-api-keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Medusa Cloud S3 Configuration (Optional)
# Only needed if using Medusa Cloud for file storage
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

# Default Region (Optional)
# The default region ID for the storefront
NEXT_PUBLIC_DEFAULT_REGION=ph

# Revalidation Configuration (Optional)
# Secret for on-demand revalidation of Next.js cache
REVALIDATE_SECRET=
