# Medusa Backend Configuration
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key_here
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_DEFAULT_REGION=ph

# Strapi CMS Configuration
# Generate token in Strapi Admin: Settings → API Tokens → Create new API Token
# Token type: Read-only
# Token duration: Unlimited
STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=your_strapi_api_token_here

# Production Example:
# STRAPI_URL=https://your-strapi-domain.com
# STRAPI_TOKEN=your_production_token_here

# Strapi Preview Configuration
# This secret must match the PREVIEW_SECRET in your Strapi CMS .env
STRAPI_PREVIEW_SECRET=sixthgear-preview-secret-2025

# Stripe Payment Configuration (TEST MODE)
# Get this from Stripe Dashboard > Developers > API Keys > Publishable key
# IMPORTANT: Only use publishable key (pk_test_...) in frontend, never secret key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
